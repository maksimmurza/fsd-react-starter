{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortTailwindcss": {
    "stylesheet": "./src/app/styles/index.css",
    "functions": ["tv", "cn"]
  },
  "tabWidth": 2,
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 80,
  "bracketSameLine": true,
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "build",
    "dist",
    "release",
    "coverage",
    "node_modules",
    ".vscode",
    "*.md",
    ".env",
    ".env*",
    ".gitignore"
  ]
}
